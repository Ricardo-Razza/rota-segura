# Copie para .env e preencha. Nunca versione o .env.

# API externa (somente GET)
ROTA_API_BASE_URL=http://localhost:9999
# Opcional: valor completo do cabeçalho Authorization, se a API passar a exigir (ex.: "Basic <chave>")
ROTA_API_AUTHORIZATION=
# Limite de páginas percorridas por consulta completa
ROTA_API_MAX_PAGINAS=200

# Jornada do aluno (opcionais; padrões em application.yml)
ROTA_ZONA=America/Sao_Paulo
ROTA_JANELA_SEM_CHEGADA=40m

# Banco próprio do painel (PostgreSQL)
ROTA_DB_URL=jdbc:postgresql://localhost:5432/rota_segura
ROTA_DB_USUARIO=rota_segura
ROTA_DB_SENHA=troque-esta-senha

# Autenticação do painel
# Segredo do JWT: no mínimo 32 caracteres aleatórios (ex.: openssl rand -base64 48)
ROTA_JWT_SECRET=
# Cookie de refresh com flag Secure. Só use false em desenvolvimento local sem HTTPS.
ROTA_COOKIE_SECURE=true
# Origens do frontend autorizadas (separadas por vírgula)
ROTA_CORS_ORIGENS=http://localhost:4200
# Administrador inicial, criado na primeira subida se ainda não existir
ROTA_ADMIN_LOGIN=
ROTA_ADMIN_SENHA=
# Documentação OpenAPI/Swagger UI do painel (deixe false em produção)
ROTA_SWAGGER_HABILITADO=false
# Atrás de proxy reverso (nginx do docker-compose): native. Rodando direto: none.
ROTA_FORWARD_HEADERS=none

# Operação em segundo plano
# Avaliação das regras de alerta a cada 30 s
ROTA_ALERTAS_HABILITADOS=true
# Índice aluno → responsáveis montado em segundo plano (GET por id na API externa)
ROTA_INDICE_RESPONSAVEIS=true

# E-mail dos relatórios agendados (opcional; sem host, o envio é ignorado e registrado só com IDs)
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_FROM=
