<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- LGPD: toda mensagem passa pela máscara de CPF, telefone e e-mail antes de ser gravada. -->
    <conversionRule conversionWord="msgLgpd"
                    class="br.com.rotasegura.shared.logging.MensagemMascaradaConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msgLgpd%n%ex{short}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
